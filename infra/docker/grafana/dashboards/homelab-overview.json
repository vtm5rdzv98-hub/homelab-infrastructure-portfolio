{
  "uid": "homelab-overview",
  "title": "HomeLab / Infrastructure Overview",
  "tags": [
    "homelab",
    "linux",
    "infrastructure"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Node health",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "targets": [
        {
          "expr": "up{job=\"linux_nodes\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Available memory (GiB)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "targets": [
        {
          "expr": "node_memory_MemAvailable_bytes{job=\"linux_nodes\"} / 1024^3",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "gbytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "CPU busy (%)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "targets": [
        {
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"linux_nodes\",mode=\"idle\"}[5m])))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Root filesystem available (GiB)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{job=\"linux_nodes\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / 1024^3",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "gbytes"
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true
}
